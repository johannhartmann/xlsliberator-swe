# Default work repository
DEFAULT_REPO_OWNER="johannhartmann"
DEFAULT_REPO_NAME="xlsliberator"

# Paths inside the persistent Open SWE sandbox
XLSLIBERATOR_CHECKOUT_PATH="/workspace/xlsliberator"
XLSLIBERATOR_ARTIFACT_ROOT="/workspace/artifacts/workbooks"

# Server-side bearer token for workbook migration trigger/follow-up/cancel APIs.
# Generate and store this as a deployment secret; never bake it into the image.
XLSLIBERATOR_TRIGGER_TOKEN=""

# MCP services. Production endpoints use HTTPS and server-side bearer tokens.
# Plain HTTP is accepted only for loopback/private/single-label Docker hosts.
# Every URL must be credential-free and end in /mcp. Leave an endpoint empty
# when the service is unavailable; migration metadata records that state.
XLSLIBERATOR_LIBREOFFICE_MCP_ENDPOINT=""
XLSLIBERATOR_CORPUS_MCP_ENDPOINT=""
XLSLIBERATOR_BUILD_FARM_MCP_ENDPOINT=""
XLSLIBERATOR_LIBREOFFICE_MCP_TOKEN=""
XLSLIBERATOR_CORPUS_MCP_TOKEN=""
XLSLIBERATOR_BUILD_FARM_MCP_TOKEN=""
# Optional comma-separated endpoint-host allowlist.
XLSLIBERATOR_MCP_ALLOWED_HOSTS=""
# Build-farm mutation additionally requires repair_flow_authorized=true on the
# server-created migration run. Keep disabled for ordinary migrations.
XLSLIBERATOR_BUILD_FARM_MUTATION_ENABLED="false"
# Credential-free, server-policy-owned capability grants. Each entry contains
# grant_id, capability, opaque resource_ref, authorized roles, and
# issued_by="server-policy". Workbook content can request but never create a
# grant. Leave empty for the secure fail-closed default.
XLSLIBERATOR_CAPABILITY_GRANTS_JSON="[]"

# Per-run migration budgets. Exhaustion ends explicitly UNRESOLVED.
XLSLIBERATOR_BUDGET_MODEL_CALLS="80"
XLSLIBERATOR_BUDGET_SPECIALIST_RUNS="24"
XLSLIBERATOR_BUDGET_RUNTIME_SESSIONS="24"
XLSLIBERATOR_BUDGET_BUILD_FARM_CALLS="8"
XLSLIBERATOR_BUDGET_COST_USD="100"
XLSLIBERATOR_BUDGET_WALL_SECONDS="5400"

# Model roles. Provider credentials remain deployment secrets and are not stored here.
XLSLIBERATOR_PRIMARY_MODEL="openai:gpt-5.5"
XLSLIBERATOR_REVIEWER_MODEL="openai:gpt-5.6-sol"
XLSLIBERATOR_SPECIALIST_MODEL="openai:gpt-5.5"

# Versioned Docker-only sandbox. Publish immutable digests in deployments.
XLSLIBERATOR_SANDBOX_IMAGE="ghcr.io/johannhartmann/xlsliberator-swe-sandbox:2026.07.0"
XLSLIBERATOR_SANDBOX_IMAGE_DIGEST=""
XLSLIBERATOR_SANDBOX_IMAGE_VERSION="2026.07.0"

# Explicit workbook-migration resource defaults.
XLSLIBERATOR_SANDBOX_CPU_COUNT="2"
XLSLIBERATOR_SANDBOX_MEMORY_BYTES="8321499136"
XLSLIBERATOR_SANDBOX_DISK_BYTES="34359738368"
XLSLIBERATOR_SANDBOX_PIDS_LIMIT="1024"
XLSLIBERATOR_SANDBOX_COMMAND_TIMEOUT_SECONDS="1800"
XLSLIBERATOR_SANDBOX_IDLE_TTL_SECONDS="7200"
XLSLIBERATOR_SANDBOX_DELETE_AFTER_STOP_SECONDS="86400"

# Trusted progressive-disclosure skills. The task/PR branch is never used as a
# skill source. Team/user paths must be pre-materialized below the reserved root.
XLSLIBERATOR_SKILLS_REPO_OWNER="johannhartmann"
XLSLIBERATOR_SKILLS_REPO_NAME="xlsliberator"
XLSLIBERATOR_SKILLS_REPO_REF="main"
XLSLIBERATOR_TEAM_SKILL_SOURCES=""
XLSLIBERATOR_USER_SKILL_SOURCES=""
