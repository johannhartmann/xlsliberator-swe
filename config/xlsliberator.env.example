# Default work repository
DEFAULT_REPO_OWNER="johannhartmann"
DEFAULT_REPO_NAME="xlsliberator"

# Paths inside the persistent Open SWE sandbox
XLSLIBERATOR_CHECKOUT_PATH="/workspace/xlsliberator"
XLSLIBERATOR_ARTIFACT_ROOT="/workspace/artifacts/workbooks"

# MCP services. Leave an endpoint empty when the service is unavailable.
XLSLIBERATOR_LIBREOFFICE_MCP_ENDPOINT=""
XLSLIBERATOR_CORPUS_MCP_ENDPOINT=""
XLSLIBERATOR_BUILD_FARM_MCP_ENDPOINT=""

# Model roles. Provider credentials remain deployment secrets and are not stored here.
XLSLIBERATOR_PRIMARY_MODEL="openai:gpt-5.5"
XLSLIBERATOR_REVIEWER_MODEL="openai:gpt-5.6-sol"
XLSLIBERATOR_SPECIALIST_MODEL="openai:gpt-5.5"

# Versioned Docker-only sandbox. Publish immutable digests in deployments.
XLSLIBERATOR_SANDBOX_IMAGE="ghcr.io/johannhartmann/xlsliberator-swe-sandbox:2026.07.0"
XLSLIBERATOR_SANDBOX_IMAGE_DIGEST=""
XLSLIBERATOR_SANDBOX_IMAGE_VERSION="2026.07.0"

# Explicit workbook-migration resource defaults.
XLSLIBERATOR_SANDBOX_CPU_COUNT="2"
XLSLIBERATOR_SANDBOX_MEMORY_BYTES="8321499136"
XLSLIBERATOR_SANDBOX_DISK_BYTES="34359738368"
XLSLIBERATOR_SANDBOX_PIDS_LIMIT="1024"
XLSLIBERATOR_SANDBOX_COMMAND_TIMEOUT_SECONDS="1800"
XLSLIBERATOR_SANDBOX_IDLE_TTL_SECONDS="7200"
XLSLIBERATOR_SANDBOX_DELETE_AFTER_STOP_SECONDS="86400"
